<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pymagic-server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyMagic.Core\PyMagic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Run\pm_debug.py" LogicalName="pm_debug.py" />
    <EmbeddedResource Include="Run\pm_db.py" LogicalName="pm_db.py" />
    <EmbeddedResource Include="Run\pm_dbserver.py" LogicalName="pm_dbserver.py" />
    <EmbeddedResource Include="Run\pm_askpass.cmd" LogicalName="pm_askpass.cmd" />
    <EmbeddedResource Include="Run\pm_rst.py" LogicalName="pm_rst.py" />
    <EmbeddedResource Include="Run\pm_tests.py" LogicalName="pm_tests.py" />
    <EmbeddedResource Include="Run\pm_console.py" LogicalName="pm_console.py" />
    <EmbeddedResource Include="Run\pm_profile.py" LogicalName="pm_profile.py" />
    <EmbeddedResource Include="Run\pm_kernel.py" LogicalName="pm_kernel.py" />
    <EmbeddedResource Include="Run\pm_jdebug.py" LogicalName="pm_jdebug.py" />
    <EmbeddedResource Include="Run\shells.json" LogicalName="shells.json" />
    <EmbeddedResource Include="Schemas\*.json" LogicalName="schema-%(Filename).json" />
    <!-- Gherkin's keywords in its languages, from Cucumber (MIT License): the licence goes with the app, in the host folder's Gherkin\ -->
    <EmbeddedResource Include="Gherkin\gherkin-languages.json" LogicalName="gherkin-languages.json" />
    <None Include="Gherkin\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- SchemaStore's catalog and schemas (Apache License 2.0), one zip read on demand: the licence goes with the app, in SchemaStore\ -->
    <EmbeddedResource Include="SchemaStore\schemas.zip" LogicalName="schemastore.zip" />
    <EmbeddedResource Include="SchemaStore\index.json" LogicalName="schemastore-index.json" />
    <None Include="SchemaStore\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- full line completion: llama.cpp, which runs the bundled model (models/fetch.mjs) on the CPU -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
  </ItemGroup>

</Project>
