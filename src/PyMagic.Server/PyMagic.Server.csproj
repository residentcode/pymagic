<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pymagic-server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyMagic.Core\PyMagic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Run\pm_debug.py" LogicalName="pm_debug.py" />
    <EmbeddedResource Include="Run\pm_db.py" LogicalName="pm_db.py" />
    <EmbeddedResource Include="Run\pm_dbserver.py" LogicalName="pm_dbserver.py" />
    <EmbeddedResource Include="Run\pm_rst.py" LogicalName="pm_rst.py" />
    <EmbeddedResource Include="Run\pm_tests.py" LogicalName="pm_tests.py" />
    <EmbeddedResource Include="Run\pm_console.py" LogicalName="pm_console.py" />
    <EmbeddedResource Include="Run\pm_profile.py" LogicalName="pm_profile.py" />
    <EmbeddedResource Include="Run\pm_kernel.py" LogicalName="pm_kernel.py" />
    <EmbeddedResource Include="Run\pm_jdebug.py" LogicalName="pm_jdebug.py" />
    <EmbeddedResource Include="Run\shells.json" LogicalName="shells.json" />
    <EmbeddedResource Include="Schemas\*.json" LogicalName="schema-%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
