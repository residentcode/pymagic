[
  {
    "id": "pwsh",
    "name": "PowerShell 7",
    "find": ["path:pwsh.exe", "%ProgramFiles%\\PowerShell\\7\\pwsh.exe"],
    "args": "-NoLogo"
  },
  {
    "id": "powershell",
    "name": "Windows PowerShell",
    "find": ["%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "path:powershell.exe"],
    "args": "-NoLogo"
  },
  {
    "id": "cmd",
    "name": "Command Prompt",
    "find": ["%ComSpec%", "%SystemRoot%\\System32\\cmd.exe"]
  },
  {
    "id": "gitbash",
    "name": "Git Bash",
    "find": ["path:git.exe>..\\bin\\bash.exe", "%ProgramFiles%\\Git\\bin\\bash.exe"],
    "args": "--login -i",
    "env": { "CHERE_INVOKING": "1" }
  },
  {
    "id": "wsl",
    "name": "WSL",
    "find": ["%SystemRoot%\\System32\\wsl.exe"]
  }
]
