# Minimal enum stub bundled with PyMagic.
from typing import Any, Iterator, TypeVar, Self

_EnumT = TypeVar("_EnumT")

class EnumMeta(type):
    __members__: dict[str, Any]
    def __iter__(self) -> Iterator[Any]: ...
    def __reversed__(self) -> Iterator[Any]: ...
    def __getitem__(self, name: str) -> Any: ...
    def __len__(self) -> int: ...
    def __contains__(self, value: object) -> bool: ...
EnumType = EnumMeta

class Enum(metaclass=EnumMeta):
    _name_: str
    _value_: Any
    _ignore_: str | list[str]
    _order_: str
    __order__: str
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> Any: ...
    def __new__(cls, value: object) -> Self: ...
    def __init__(self, *args: Any) -> None: ...
    def __hash__(self) -> int: ...
    @classmethod
    def _missing_(cls, value: object) -> Any: ...
    @staticmethod
    def _generate_next_value_(name: str, start: int, count: int, last_values: list[Any]) -> Any: ...

class ReprEnum(Enum): ...

class IntEnum(int, ReprEnum):
    _value_: int
    @property
    def value(self) -> int: ...

class StrEnum(str, ReprEnum):
    _value_: str
    @property
    def value(self) -> str: ...

class Flag(Enum):
    _name_: str | None
    _value_: int
    @property
    def name(self) -> str | None: ...
    @property
    def value(self) -> int: ...
    def __contains__(self, other: Self) -> bool: ...
    def __bool__(self) -> bool: ...
    def __or__(self, other: Self) -> Self: ...
    def __and__(self, other: Self) -> Self: ...
    def __xor__(self, other: Self) -> Self: ...
    def __invert__(self) -> Self: ...

class IntFlag(int, ReprEnum, Flag):
    def __or__(self, other: int) -> Self: ...
    def __and__(self, other: int) -> Self: ...
    def __xor__(self, other: int) -> Self: ...

class auto:
    _value_: Any
    def __init__(self) -> None: ...

def unique(enumeration: _EnumT) -> _EnumT: ...
def verify(*checks: Any) -> Any: ...
def global_enum(cls: _EnumT, update_str: bool = False) -> _EnumT: ...
